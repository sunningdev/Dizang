<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoAudioMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoAudio" id="FoAudioResult">
        <id property="id" column="id"/><result property="categoryId" column="category_id"/><result property="title" column="title"/>
        <result property="description" column="description"/><result property="coverUrl" column="cover_url"/><result property="fileUrl" column="file_url"/>
        <result property="duration" column="duration"/><result property="playCount" column="play_count"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,category_id,title,description,cover_url,file_url,duration,play_count,create_by,create_time,update_by,update_time,remark from fo_audio</sql>
    <select id="selectFoAudioList" parameterType="com.ruoyi.system.domain.dizang.FoAudio" resultMap="FoAudioResult">
        <include refid="selectVo"/><where><if test="categoryId != null">and category_id=#{categoryId}</if><if test="title != null and title != ''">and title like concat('%',#{title},'%')</if></where>order by id desc
    </select>
    <select id="selectFoAudioById" parameterType="Long" resultMap="FoAudioResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoAudio" parameterType="com.ruoyi.system.domain.dizang.FoAudio" useGeneratedKeys="true" keyProperty="id">
        insert into fo_audio(category_id,title,description,cover_url,file_url,duration,play_count,create_by,create_time)
        values(#{categoryId},#{title},#{description},#{coverUrl},#{fileUrl},#{duration},#{playCount},#{createBy},sysdate())
    </insert>
    <update id="updateFoAudio" parameterType="com.ruoyi.system.domain.dizang.FoAudio">
        update fo_audio <set><if test="title != null">title=#{title},</if><if test="description != null">description=#{description},</if><if test="fileUrl != null">file_url=#{fileUrl},</if><if test="duration != null">duration=#{duration},</if>update_by=#{updateBy},update_time=sysdate()</set> where id=#{id}
    </update>
    <delete id="deleteFoAudioById" parameterType="Long">delete from fo_audio where id=#{id}</delete>
    <delete id="deleteFoAudioByIds" parameterType="String">delete from fo_audio where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>