<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoClassicMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoClassic" id="FoClassicResult">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="coverUrl" column="cover_url"/>
        <result property="category" column="category"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,title,description,cover_url,category,create_by,create_time,update_by,update_time,remark from fo_classic</sql>
    <select id="selectFoClassicList" parameterType="com.ruoyi.system.domain.dizang.FoClassic" resultMap="FoClassicResult">
        <include refid="selectVo"/>
        <where>
            <if test="title != null and title != ''">and title like concat('%',#{title},'%')</if>
            <if test="category != null and category != ''">and category=#{category}</if>
        </where>
        order by id asc
    </select>
    <select id="selectFoClassicById" parameterType="Long" resultMap="FoClassicResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoClassic" parameterType="com.ruoyi.system.domain.dizang.FoClassic" useGeneratedKeys="true" keyProperty="id">
        insert into fo_classic(title,description,cover_url,category,create_by,create_time)
        values(#{title},#{description},#{coverUrl},#{category},#{createBy},sysdate())
    </insert>
    <update id="updateFoClassic" parameterType="com.ruoyi.system.domain.dizang.FoClassic">
        update fo_classic
        <set>
            <if test="title != null">title=#{title},</if>
            <if test="description != null">description=#{description},</if>
            <if test="coverUrl != null">cover_url=#{coverUrl},</if>
            <if test="category != null">category=#{category},</if>
            update_by=#{updateBy},update_time=sysdate()
        </set>
        where id=#{id}
    </update>
    <delete id="deleteFoClassicById" parameterType="Long">delete from fo_classic where id=#{id}</delete>
    <delete id="deleteFoClassicByIds" parameterType="String">delete from fo_classic where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>