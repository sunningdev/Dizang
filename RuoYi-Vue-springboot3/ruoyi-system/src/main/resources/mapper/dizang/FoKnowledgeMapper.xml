<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoKnowledgeMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoKnowledge" id="FoKnowledgeResult">
        <id property="id" column="id"/><result property="categoryId" column="category_id"/><result property="title" column="title"/>
        <result property="summary" column="summary"/><result property="content" column="content"/><result property="coverUrl" column="cover_url"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,category_id,title,summary,content,cover_url,create_by,create_time,update_by,update_time,remark from fo_knowledge</sql>
    <select id="selectFoKnowledgeList" parameterType="com.ruoyi.system.domain.dizang.FoKnowledge" resultMap="FoKnowledgeResult">
        <include refid="selectVo"/><where><if test="categoryId != null">and category_id=#{categoryId}</if><if test="title != null and title != ''">and title like concat('%',#{title},'%')</if></where>order by id desc
    </select>
    <select id="selectFoKnowledgeById" parameterType="Long" resultMap="FoKnowledgeResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoKnowledge" parameterType="com.ruoyi.system.domain.dizang.FoKnowledge" useGeneratedKeys="true" keyProperty="id">
        insert into fo_knowledge(category_id,title,summary,content,cover_url,create_by,create_time) values(#{categoryId},#{title},#{summary},#{content},#{coverUrl},#{createBy},sysdate())
    </insert>
    <update id="updateFoKnowledge" parameterType="com.ruoyi.system.domain.dizang.FoKnowledge">
        update fo_knowledge <set><if test="title != null">title=#{title},</if><if test="summary != null">summary=#{summary},</if><if test="content != null">content=#{content},</if><if test="coverUrl != null">cover_url=#{coverUrl},</if>update_by=#{updateBy},update_time=sysdate()</set> where id=#{id}
    </update>
    <delete id="deleteFoKnowledgeById" parameterType="Long">delete from fo_knowledge where id=#{id}</delete>
    <delete id="deleteFoKnowledgeByIds" parameterType="String">delete from fo_knowledge where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>