<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoMasterMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoMaster" id="FoMasterResult">
        <id property="id" column="id"/><result property="name" column="name"/>
        <result property="avatar" column="avatar"/><result property="bio" column="bio"/>
        <result property="sortOrder" column="sort_order"/><result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,name,avatar,bio,sort_order,create_by,create_time,update_by,update_time,remark from fo_master</sql>
    <select id="selectFoMasterList" parameterType="com.ruoyi.system.domain.dizang.FoMaster" resultMap="FoMasterResult">
        <include refid="selectVo"/><where><if test="name != null and name != ''">and name like concat('%',#{name},'%')</if></where>order by sort_order
    </select>
    <select id="selectFoMasterById" parameterType="Long" resultMap="FoMasterResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoMaster" parameterType="com.ruoyi.system.domain.dizang.FoMaster" useGeneratedKeys="true" keyProperty="id">
        insert into fo_master(name,avatar,bio,sort_order,create_by,create_time) values(#{name},#{avatar},#{bio},#{sortOrder},#{createBy},sysdate())
    </insert>
    <update id="updateFoMaster" parameterType="com.ruoyi.system.domain.dizang.FoMaster">
        update fo_master <set><if test="name != null">name=#{name},</if><if test="avatar != null">avatar=#{avatar},</if><if test="bio != null">bio=#{bio},</if><if test="sortOrder != null">sort_order=#{sortOrder},</if>update_by=#{updateBy},update_time=sysdate()</set> where id=#{id}
    </update>
    <delete id="deleteFoMasterById" parameterType="Long">delete from fo_master where id=#{id}</delete>
    <delete id="deleteFoMasterByIds" parameterType="String">delete from fo_master where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>