<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoKnowledgeCategoryMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoKnowledgeCategory" id="FoKnowledgeCategoryResult">
        <id property="id" column="id"/><result property="name" column="name"/><result property="sortOrder" column="sort_order"/>
        <result property="createBy" column="create_by"/><result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/><result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,name,sort_order,create_by,create_time,update_by,update_time,remark from fo_knowledge_category</sql>
    <select id="selectFoKnowledgeCategoryList" parameterType="com.ruoyi.system.domain.dizang.FoKnowledgeCategory" resultMap="FoKnowledgeCategoryResult">
        <include refid="selectVo"/><where><if test="name != null and name != ''">and name like concat('%',#{name},'%')</if></where>order by sort_order
    </select>
    <select id="selectFoKnowledgeCategoryById" parameterType="Long" resultMap="FoKnowledgeCategoryResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoKnowledgeCategory" parameterType="com.ruoyi.system.domain.dizang.FoKnowledgeCategory" useGeneratedKeys="true" keyProperty="id">
        insert into fo_knowledge_category(name,sort_order,create_by,create_time) values(#{name},#{sortOrder},#{createBy},sysdate())
    </insert>
    <update id="updateFoKnowledgeCategory" parameterType="com.ruoyi.system.domain.dizang.FoKnowledgeCategory">
        update fo_knowledge_category <set><if test="name != null">name=#{name},</if><if test="sortOrder != null">sort_order=#{sortOrder},</if>update_by=#{updateBy},update_time=sysdate()</set> where id=#{id}
    </update>
    <delete id="deleteFoKnowledgeCategoryById" parameterType="Long">delete from fo_knowledge_category where id=#{id}</delete>
    <delete id="deleteFoKnowledgeCategoryByIds" parameterType="String">delete from fo_knowledge_category where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>