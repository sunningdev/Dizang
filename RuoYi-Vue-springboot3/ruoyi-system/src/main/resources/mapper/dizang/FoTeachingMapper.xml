<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.dizang.FoTeachingMapper">
    <resultMap type="com.ruoyi.system.domain.dizang.FoTeaching" id="FoTeachingResult">
        <id property="id" column="id"/><result property="masterId" column="master_id"/>
        <result property="title" column="title"/><result property="summary" column="summary"/>
        <result property="content" column="content"/><result property="coverUrl" column="cover_url"/>
        <result property="publishTime" column="publish_time"/><result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/><result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/><result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectVo">select id,master_id,title,summary,content,cover_url,publish_time,create_by,create_time,update_by,update_time,remark from fo_teaching</sql>
    <select id="selectFoTeachingList" parameterType="com.ruoyi.system.domain.dizang.FoTeaching" resultMap="FoTeachingResult">
        <include refid="selectVo"/><where><if test="masterId != null">and master_id=#{masterId}</if><if test="title != null and title != ''">and title like concat('%',#{title},'%')</if></where>order by publish_time desc
    </select>
    <select id="selectFoTeachingById" parameterType="Long" resultMap="FoTeachingResult"><include refid="selectVo"/> where id=#{id}</select>
    <insert id="insertFoTeaching" parameterType="com.ruoyi.system.domain.dizang.FoTeaching" useGeneratedKeys="true" keyProperty="id">
        insert into fo_teaching(master_id,title,summary,content,cover_url,publish_time,create_by,create_time) values(#{masterId},#{title},#{summary},#{content},#{coverUrl},#{publishTime},#{createBy},sysdate())
    </insert>
    <update id="updateFoTeaching" parameterType="com.ruoyi.system.domain.dizang.FoTeaching">
        update fo_teaching <set><if test="title != null">title=#{title},</if><if test="summary != null">summary=#{summary},</if><if test="content != null">content=#{content},</if><if test="coverUrl != null">cover_url=#{coverUrl},</if><if test="publishTime != null">publish_time=#{publishTime},</if>update_by=#{updateBy},update_time=sysdate()</set> where id=#{id}
    </update>
    <delete id="deleteFoTeachingById" parameterType="Long">delete from fo_teaching where id=#{id}</delete>
    <delete id="deleteFoTeachingByIds" parameterType="String">delete from fo_teaching where id in <foreach collection="array" item="id" open="(" separator="," close=")">#{id}</foreach></delete>
</mapper>